generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Users & Auth ----------

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  handle            String   @unique
  displayName       String
  avatarUrl         String?
  spoilerSensitivity SpoilerSensitivity @default(HIDE_RECENT)
  favoriteGenres    String[] @default([])
  notificationsEnabled Boolean @default(true)
  // Per-type opt-outs. Empty means "all types enabled"; the global
  // notificationsEnabled flag still overrides everything when false.
  mutedNotificationTypes NotificationType[] @default([])
  role              UserRole @default(USER)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  refreshTokens     RefreshToken[]
  watchlistItems    WatchlistItem[]
  follows           Follow[]
  posts             CommunityPost[]
  comments          CommunityComment[]
  reactions         Reaction[]
  reportsFiled      Report[] @relation("ReportsFiled")
  blocksMade        UserBlock[] @relation("BlocksMade")
  blocksReceived    UserBlock[] @relation("BlocksReceived")
  entitlement       Entitlement?
  aiConversations   AiConversation[]
  aiUsageEvents     AiUsageEvent[]
  notifications     Notification[]
  analyticsEvents   AnalyticsEvent[]
  savedJourneys     SavedJourney[]
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum SpoilerSensitivity {
  HIDE_ALL
  HIDE_RECENT
  SHOW_ALL
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Titles (movies/tv/games) ----------
// Slate does not duplicate TMDB/IGDB catalogs locally. `Title` is a thin,
// cached pointer + Slate-specific state (hype score, follow/watchlist
// relations); full metadata is fetched live from the provider and cached
// short-term at the HTTP layer, per each provider's ToS on redistribution.

enum MediaType {
  MOVIE
  TV
  GAME
}

model Title {
  id              String    @id // `${mediaType}:${externalId}` e.g. "movie:27205"
  mediaType       MediaType
  externalId      String
  name            String
  releaseDate     DateTime?
  releaseDatePrecision String @default("unknown")
  hypeScore       Float     @default(0)
  lastSyncedAt    DateTime  @default(now())

  watchlistItems  WatchlistItem[]
  follows         Follow[]
  posts           CommunityPost[]

  @@unique([mediaType, externalId])
  @@index([releaseDate])
}

// ---------- Watchlist & Follows ----------

enum WatchlistStatus {
  WANT_TO_WATCH
  WATCHING
  COMPLETED
  DROPPED
}

model WatchlistItem {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId   String
  title     Title           @relation(fields: [titleId], references: [id], onDelete: Cascade)
  status    WatchlistStatus @default(WANT_TO_WATCH)
  addedAt   DateTime        @default(now())

  @@unique([userId, titleId])
  @@index([userId])
}

model Follow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId   String
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, titleId])
  @@index([userId])
  @@index([titleId])
}

// ---------- Watch / Play Journeys ----------

enum JourneyKind {
  WATCH
  PLAY
}

// A journey the user is tracking. Step membership/order is resolved from
// provider franchise data at build time and snapshotted here; progress is
// recomputed live from the user's COMPLETED watchlist entries rather than
// stored, so it can never drift from what they've actually finished.
model SavedJourney {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  kind          JourneyKind
  mediaType     MediaType
  stepTitleIds  String[]
  targetTitleId String?
  createdAt     DateTime    @default(now())

  @@index([userId])
}

// ---------- Community ----------

enum PostKind {
  DISCUSSION
  PREDICTION
  THEORY
  REVIEW
}

model CommunityPost {
  id               String   @id @default(cuid())
  authorId         String
  author           User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  titleId          String
  title            Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  kind             PostKind @default(DISCUSSION)
  body             String
  containsSpoilers Boolean  @default(false)
  createdAt        DateTime @default(now())
  deletedAt        DateTime?

  comments  CommunityComment[]
  reactions Reaction[]
  reports   Report[]

  @@index([titleId])
  @@index([authorId])
}

model CommunityComment {
  id               String   @id @default(cuid())
  postId           String
  post             CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId         String
  author           User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentCommentId  String?
  body             String
  containsSpoilers Boolean  @default(false)
  createdAt        DateTime @default(now())
  deletedAt        DateTime?

  reports Report[]

  @@index([postId])
}

enum ReactionKind {
  HYPE
  LOVE
  MINDBLOWN
  LAUGH
  SKEPTICAL
}

model Reaction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  kind      ReactionKind
  createdAt DateTime     @default(now())

  @@unique([userId, postId, kind])
  @@index([postId])
}

// Google Play's User Generated Content policy requires apps with social
// features to give users a way to block other users, not just report them.
// A block is one-directional and private: the blocked user is never told,
// and blocking hides their posts, comments and reactions from the blocker's
// view of the community.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

enum ReportReason {
  SPAM
  HARASSMENT
  UNMARKED_SPOILER
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  postId     String?
  post       CommunityPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason     ReportReason
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  @@index([status])
}

// ---------- Billing / Entitlements ----------
// Source of truth for Pro access. The mobile client's local purchase state
// is never trusted on its own — see apps/backend/src/modules/billing.

enum SlateProProduct {
  SLATE_PRO_MONTHLY
  SLATE_PRO_YEARLY
}

enum EntitlementStatus {
  NONE
  PENDING
  ACTIVE
  GRACE_PERIOD
  ON_HOLD
  CANCELLED
  EXPIRED
  REVOKED
}

model Entitlement {
  id                  String            @id @default(cuid())
  userId              String            @unique
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId           SlateProProduct?
  status              EntitlementStatus @default(NONE)
  expiresAt           DateTime?
  autoRenewing        Boolean           @default(false)
  startedAt           DateTime?
  latestPurchaseToken String?
  updatedAt           DateTime          @updatedAt

  purchaseEvents PurchaseEvent[]

  // Google's RTDN webhook identifies a subscription only by its purchase
  // token, so every renewal, cancellation and grace-period notification
  // looks the entitlement up by this column. Without an index that is a
  // sequential scan over every subscriber on each notification.
  //
  // Deliberately not @unique: during an account transfer or a re-purchase
  // two rows can briefly carry the same token, and a unique constraint
  // would turn that into a write failure on a legitimate path.
  @@index([latestPurchaseToken])
}

// Immutable audit log of every purchase/notification received from Google
// Play, and the deduplication key for at-least-once RTDN delivery.
//
// The key includes the expiry, not just (token, status). A subscription
// returns to the same state constantly — every renewal reports ACTIVE again,
// and a recovered payment goes IN_GRACE_PERIOD -> ACTIVE — so keying on
// (token, status) alone treats a renewal as a duplicate and drops it. That
// left paying subscribers stuck at their first expiry date and silently
// losing Pro one billing period after they paid.
//
// The expiry is what distinguishes a genuinely new notification from a
// redelivery of one already seen: Pub/Sub redelivering the same message
// carries the same expiry, while a renewal or a grace-period recovery moves
// it. Non-nullable on purpose — in Postgres NULLs are distinct, so a nullable
// column would silently disable deduplication.
model PurchaseEvent {
  id              String   @id @default(cuid())
  entitlementId   String
  entitlement     Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  purchaseToken   String
  productId       SlateProProduct
  rawStatus       String   // raw Play Developer API / RTDN status for audit
  expiresAt       DateTime // the expiry Google reported with this notification
  processedAt     DateTime @default(now())

  @@unique([purchaseToken, rawStatus, expiresAt])
  @@index([entitlementId])
}

// ---------- AI / Ask Slate ----------

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId   String?
  createdAt DateTime @default(now())

  messages AiMessage[]

  @@index([userId])
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String   // "user" | "assistant"
  content        String
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

// Per-user, per-day usage counter used to enforce free/Pro AI limits without
// scanning message history on every request.
model AiUsageEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime // truncated to day (UTC)
  count     Int      @default(0)

  @@unique([userId, date])
}

// ---------- Notifications ----------

enum NotificationType {
  RELEASE_REMINDER
  FOLLOWED_TITLE_UPDATE
  COMMUNITY_REPLY
  COMMUNITY_MENTION
  SUBSCRIPTION_STATUS
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, readAt])
}

// ---------- Analytics (minimal, first-party) ----------

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  properties Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}
