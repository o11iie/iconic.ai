# =============================================================================
# VEO — Environment Configuration
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
#
#   cp .env.example .env.local
#
# RULES
#   * `.env.local` is git-ignored. NEVER commit real credentials.
#   * Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
#     Everything else is server-only and is validated in `src/config/env.ts`,
#     which throws if server-only keys are read from client code.
#   * The app boots without optional keys; the features that need them report
#     an explicit "not configured" state rather than failing silently.
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION  (required)
# -----------------------------------------------------------------------------
# Absolute origin of this deployment. Used for auth redirects and OAuth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# SUPABASE — Auth, Database, Storage  (required for auth + persistence)
# -----------------------------------------------------------------------------
# Where to find these: Supabase Dashboard -> Project Settings -> API
#
# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / publishable key. Safe for the browser: it is constrained by the
# Row Level Security policies in supabase/migrations.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security entirely. Never prefix with
# NEXT_PUBLIC_, never import into a Client Component. Used only by trusted
# server code (admin tasks, webhooks, migrations).
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# OPENAI — AI tutor, ingestion, question + flashcard generation  (optional)
# -----------------------------------------------------------------------------
# SERVER ONLY. All model calls are proxied through VEO server routes so this
# key is never shipped to the browser. Where: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Default model id used by the tutor abstraction.
OPENAI_MODEL=gpt-4o-mini


# -----------------------------------------------------------------------------
# STRIPE — Subscriptions and entitlements  (optional)
# -----------------------------------------------------------------------------
# SERVER ONLY. Where: Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=

# SERVER ONLY. Stripe Dashboard -> Developers -> Webhooks -> signing secret.
# Required to verify webhook authenticity before granting entitlements.
STRIPE_WEBHOOK_SECRET=

# Browser-safe publishable key, used by Stripe.js at checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=


# -----------------------------------------------------------------------------
# SPATIAL / ANATOMY ASSET PROVIDER  (optional until a licence is in place)
# -----------------------------------------------------------------------------
# VEO does NOT generate synthetic anatomy. Production anatomy requires licensed
# assets or a licensed provider SDK. Until one is configured, anatomy surfaces
# report an explicit "no licensed model configured" state.
#
# Which provider implementation to activate. See src/anatomy/providers/registry.ts
#   gltf-asset  -> licensed GLB/GLTF assets served from the base URL below
#   (additional licensed SDK providers register here as they are integrated)
NEXT_PUBLIC_ANATOMY_PROVIDER=gltf-asset

# Base URL that licensed GLB/GLTF assets + their semantic mapping manifests are
# served from (Supabase Storage bucket, signed CDN, etc.). Leave empty when no
# licensed asset set is available.
NEXT_PUBLIC_SPATIAL_ASSET_BASE_URL=

# Enables the isolated 3D pipeline diagnostic at /explore?diagnostic=1.
# This renders a NON-ANATOMICAL calibration object used purely to verify that
# the WebGL render pipeline works. Never enable in production as anatomy.
NEXT_PUBLIC_ENABLE_PIPELINE_DIAGNOSTIC=true

# Supabase OAuth providers enabled for this deployment, comma-separated.
# e.g. google,github,apple  — each must also be enabled in the Supabase
# dashboard under Authentication -> Providers. Leave empty for password auth
# only; the sign-in screen then omits the social section rather than showing
# buttons that cannot work.
NEXT_PUBLIC_OAUTH_PROVIDERS=
