{
  "name": "veo",
  "version": "0.1.0",
  "private": true,
  "description": "VEO \u2014 Learning you can see. A spatial-learning platform.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "validate:anatomy": "tsx scripts/validate-anatomy.mts",
    "test:ui": "node scripts/verify-ui.mjs",
    "test:engine": "node scripts/verify-engine.mjs",
    "test:semantics": "node scripts/verify-semantics.mjs",
    "test:spatial": "node scripts/verify-spatial.mjs",
    "test:anatomy": "node scripts/verify-anatomy.mjs",
    "test:browser": "npm run test:ui && npm run test:engine && npm run test:semantics && npm run test:spatial && npm run test:anatomy && npm run test:tutor",
    "verify:full": "VEO_TUTOR_STUB=1 npm run verify && npm run start:verify",
    "start:verify": "VEO_TUTOR_STUB=1 next start -p 3410 & sleep 5 && npm run test:browser; kill %1",
    "test:tutor": "node scripts/verify-tutor.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "clsx": "2.1.1",
    "framer-motion": "13.3.0",
    "next": "16.3.5",
    "openai": "7.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "22.6.2",
    "tailwind-merge": "3.7.0",
    "three": "0.186.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.20.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.0.1",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
