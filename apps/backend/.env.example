# Copy to .env and fill in real values. NEVER commit .env.
DATABASE_URL="postgresql://slate:slate@localhost:5432/slate?schema=public"

# Auth
JWT_ACCESS_SECRET="replace-with-64-char-random-secret"
JWT_REFRESH_SECRET="replace-with-different-64-char-random-secret"

# TMDB (https://www.themoviedb.org/settings/api) — free, instant approval
TMDB_API_KEY=

# IGDB via Twitch dev app (https://dev.twitch.tv/console/apps) — free
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Ask Slate — OpenAI (server-side only, never sent to the mobile client)
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"

# Google Play Billing server-side verification
# Service account JSON for the Play Developer API (Android Publisher).
# https://developer.android.com/google/play/billing/getting-ready
GOOGLE_PLAY_PACKAGE_NAME="ai.iconic.slate"
GOOGLE_SERVICE_ACCOUNT_JSON=
# Shared secret proving an inbound RTDN webhook came from our own Pub/Sub push
# subscription. Generate a long random value and configure the subscription's
# push endpoint as https://<host>/api/billing/rtdn?token=<this value>.
RTDN_SHARED_SECRET=

PORT=4000
NODE_ENV=development
